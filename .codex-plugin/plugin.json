{
  "name": "mcpserver-codex",
  "version": "1.36.0",
  "description": "Connect Codex CLI to McpServer for session logging, TODO management, requirements tracking, and subagent transcript capture.",
  "author": {
    "name": "Payton Byrd (The Sharp Ninja)",
    "url": "https://github.com/sharpninja"
  },
  "homepage": "https://github.com/sharpninja/McpServer",
  "repository": "https://github.com/sharpninja/mcpserver-claude-code-plugin",
  "license": "MIT",
  "keywords": [
    "mcp",
    "session-log",
    "codex",
    "subagent",
    "todo",
    "requirements"
  ],
  "skillsPath": "skills",
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "pwsh -NoLogo -NoProfile -NonInteractive -File \u0022${PLUGIN_ROOT}/hooks/scripts/session-start.ps1\u0022",
        "timeout": 15
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "command": "pwsh -NoLogo -NoProfile -NonInteractive -File \u0022${PLUGIN_ROOT}/hooks/scripts/session-end.ps1\u0022",
        "timeout": 10
      }
    ],
    "userPromptSubmit": [
      {
        "type": "command",
        "command": "pwsh -NoLogo -NoProfile -NonInteractive -File \u0022${PLUGIN_ROOT}/hooks/scripts/user-prompt-submit.ps1\u0022",
        "timeout": 10
      }
    ],
    "taskComplete": [
      {
        "type": "command",
        "command": "pwsh -NoLogo -NoProfile -NonInteractive -File \u0022${PLUGIN_ROOT}/lib/final-response.ps1\u0022",
        "timeout": 15,
        "description": "Complete MCP session-log turn with rich fields from Codex JSONL"
      }
    ],
    "subagentComplete": [
      {
        "type": "command",
        "command": "pwsh -NoLogo -NoProfile -NonInteractive -File \u0022${PLUGIN_ROOT}/hooks/scripts/subagent-import.ps1\u0022",
        "timeout": 30,
        "description": "Import subagent JSONL transcript as first-class MCP session-log turns"
      }
    ]
  },
  "codexFeatures": {
    "jsonlParsing": true,
    "subagentCapture": true,
    "richTurnFields": true,
    "secretRedaction": true
  }
}
